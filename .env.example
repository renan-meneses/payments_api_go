# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=debug                     # debug | info | warn | error
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_REQUEST_TIMEOUT=12s

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_DSN=postgres://payments:payments@localhost:5432/payments?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# Kafka (empty KAFKA_BROKERS disables publishing)
# ---------------------------------------------------------------------------
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC=payments.events
KAFKA_CLIENT_ID=payments-api
KAFKA_CONSUMER_GROUP=payments-audit
KAFKA_ENABLED=true

# ---------------------------------------------------------------------------
# Auth / protection
# ---------------------------------------------------------------------------
# Comma separated list of "api-key:tenant" pairs.
API_KEYS=dev-key:local-dev
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_FAIL_OPEN=true

# ---------------------------------------------------------------------------
# Payment providers
# ---------------------------------------------------------------------------
CARD_PROVIDER=stripe
PIX_PROVIDER=static                 # mercadopago | static (local/dev BR Code generator)
PIX_EXPIRATION=30m
MAX_AMOUNT_CENTS=100000000          # R$ 1.000.000,00

STRIPE_API_KEY=
STRIPE_BASE_URL=https://api.stripe.com
STRIPE_TIMEOUT=15s

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=http://localhost:8080/v1/webhooks/mercadopago
MERCADOPAGO_TIMEOUT=15s

STATIC_PIX_KEY=dev-pix-key@example.com
STATIC_PIX_MERCHANT_NAME=PAYMENTS API STORE
STATIC_PIX_MERCHANT_CITY=SAO PAULO

# Dev-only endpoint that simulates a PIX confirmation webhook.
ALLOW_PIX_SIMULATION=true

# ---------------------------------------------------------------------------
# Idempotency & dashboard cache
# ---------------------------------------------------------------------------
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_LOCK_TTL=45s
DASHBOARD_CACHE_TTL=60s
DASHBOARD_MAX_RANGE=8784h           # 366 days
